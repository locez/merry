from collections.abc import Awaitable

class NativeMerryError(Exception):
    """Rust-originated error carrying a serialized MerryErrorInfo payload."""

class AgentBuilder:
    def __init__(self, session_id: str) -> None: ...
    def with_openai_compatible(
        self,
        api_key: str,
        model: str,
        base_url: str | None,
        protocol: str,
    ) -> None: ...
    def with_anthropic(
        self, api_key: str, model: str, base_url: str | None
    ) -> None: ...
    def with_prompt_profile(
        self,
        base_instructions: str | None,
        progress_commentary: bool | None,
        progress_commentary_instructions: str | None,
        stable_blocks: list[tuple[str, str]],
    ) -> None: ...
    def with_generation_config(
        self,
        max_output_tokens: int | None,
        parallel_tool_calls: str | None,
        reasoning_effort: str | None,
        service_tier: str | None,
    ) -> None: ...
    def with_workspace(
        self,
        root: str,
        readonly_resource_roots: list[str],
        enable_patch: bool,
        patch_write_scope: list[str] | None,
        forbidden_paths: list[str],
        max_read_bytes: int | None,
        max_read_lines: int | None,
        max_write_bytes: int | None,
        max_patch_bytes: int | None,
    ) -> None: ...
    def register_bridge_tool(
        self, name: str, description: str, schema_json: str
    ) -> None: ...
    def with_session_store(self, path: str) -> None: ...
    def with_history_retention(
        self,
        mode: str,
        max_segments: int | None,
        max_bytes: int | None,
        export_markdown: bool | None,
    ) -> None: ...
    def with_max_model_turns(self, value: int) -> None: ...
    def with_event_buffer_size(self, value: int) -> None: ...
    def build(self) -> Agent: ...
    def resume(self, path: str | None = None) -> Awaitable[Agent]: ...
    def is_consumed(self) -> bool: ...

class Agent:
    def session_id(self) -> str: ...
    def stream(self, task: str, final_output_schema_json: str | None) -> AgentRun: ...
    def start_interactive(self) -> InteractiveRun: ...
    def save_session(self) -> Awaitable[None]: ...

class AgentRun:
    def next(self) -> Awaitable[str | None]: ...
    def submit_tool_results(
        self, batch_id: str, results_json: str
    ) -> Awaitable[str]: ...
    def result(self) -> Awaitable[str]: ...
    def cancel(self) -> Awaitable[str]: ...

class InteractiveRun:
    def next(self) -> Awaitable[str | None]: ...
    def submit_tool_results(
        self, batch_id: str, results_json: str
    ) -> Awaitable[str]: ...
    def submit(self, text: str) -> Awaitable[str]: ...
    def update_input(self, input_id: int, text: str) -> Awaitable[None]: ...
    def remove_input(self, input_id: int) -> Awaitable[None]: ...
    def set_paused(self, paused: bool) -> Awaitable[None]: ...
    def flush(self) -> Awaitable[None]: ...
    def snapshot(self) -> Awaitable[str]: ...
    def interrupt(self) -> Awaitable[None]: ...
    def save_session(self, path: str | None = None) -> Awaitable[None]: ...
    def close(self) -> Awaitable[None]: ...

def version() -> str: ...
